          "sv": "Risk för vattenbrist - Grundvatten och vattendrag",
          "en": "Risk for water shortage - Groundwater and watercourses",
          "code": "WATERCOURSES_GROUNDWATER_MINOR_MAJOR"
        },
        "affectedAreas": [
          { "id": 8, "sv": "Kalmar län", "en": "Kalmar County" }
